    "@react-router/serve": "^8.3.0",
    "@shikijs/rehype": "^4.4.3",
    "gray-matter": "^4.0.3",
    "isbot": "^5",
    "lucide-react": "^1.33.0",
    "minisearch": "^7.2.0",
    "github-slugger": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
